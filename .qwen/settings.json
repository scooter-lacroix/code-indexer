{
  "mcpServers": {
    "code-index": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--index-url",
        "https://pypi.org/simple/",
        "--extra-index-url",
        "https://download.pytorch.org/whl/cpu",
        "--index-strategy",
        "unsafe-best-match",
        "sc-code-indexer==2.0.1"
      ],
      "env": {
        "MCP_TIMEOUT": "300000",
        "MCP_TOOL_TIMEOUT": "300000"
      }
    },
    "mcp-emotional-support": {
      "command": "npx",
      "args": [
        "mcp-emotional-support",
        "--config=/home/stan/.config/emotional-support-config.json"
      ]
    }
  },
  "$version": 2
}